{
  "name": "aggregator-backend",
  "version": "1.0.0",
  "description": "Payment Aggregator Backend - PSP Solution",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "db:check-indexes": "node scripts/check-indexes.js",
    "db:cleanup-indexes": "node scripts/cleanup-indexes.js",
    "db:safe-sync": "node scripts/safe-sync.js",
    "db:fix-duplicates": "node scripts/fix-duplicate-indexes.js",
    "migrate:prod": "node scripts/migrate-production.js",
    "migrate:prod-fixed": "node scripts/migrate-production-fixed.js",
    "db:diagnose": "node scripts/diagnose-db.js",
    "db:fix-formation-packages": "node scripts/fix-formation-packages.js",
    "db:fix-formations-column": "node scripts/fix-formation-packages-column.js",
    "db:full-diagnostic": "node scripts/db-full-diagnostic.js",
    "db:conservative-sync": "node scripts/db-conservative-sync.js",
    "db:validate-all": "node scripts/db-validate-all.js",
    "db:health-check": "node scripts/db-health-check.js",
    "db:weekly-report": "node scripts/db-weekly-report.js",
    "db:monitoring-setup": "node scripts/db-monitoring-setup.js",
    "seed:prod": "node scripts/seed-production.js",
    "db:complete-fix": "npm run db:full-diagnostic && npm run db:conservative-sync && npm run db:validate-all",
    "deploy:setup": "npm run db:full-diagnostic && npm run db:conservative-sync && npm run db:validate-all && npm run db:monitoring-setup && npm run seed:prod"
  },
  "dependencies": {
    "@kkiapay-org/nodejs-sdk": "^1.0.7",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.0",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.18.0",
    "puppeteer": "^23.11.1",
    "sequelize": "^6.37.5",
    "stripe": "^17.5.0",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
