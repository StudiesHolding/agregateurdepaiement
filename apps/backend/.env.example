# ============================================================
# Agrégateur de paiement — exemple de configuration (.env)
# Copier vers .env et adapter. Ne jamais committer le .env réel.
# ============================================================

# --- Base de données (MariaDB/MySQL) ---
DATABASE_NAME=agregateur
DATABASE_USER=user
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=3306

# --- Redis (BullMQ, saga) ---
REDIS_URL=redis://localhost:6379

# --- Authoring Engine (Moodle, M2M signé HMAC) ---
AUTHORING_ENGINE_URL=http://localhost:4001
SAGA_API_KEY=change-me-secret-partage
M2M_HTTP_TIMEOUT=15000

# --- Backend métier Studies Learning (API interne, clé partagée) ---
# Le backend NewStudies (port 4000 en local) est appelé pour : le contexte d'achat (enroll-intent), l'inscription
# après paiement (/api/internal/enrollments), le crédit de commission (/api/internal/payments/confirmed), la TVA B2B
# (/api/internal/tax-rules), les taux de change (/api/internal/fx) et les coupons (/api/internal/coupons).
SL_BACKEND_URL=http://localhost:4000
SL_BACKEND_API_PREFIX=/api/v1
# MÊME valeur que INTERNAL_API_KEY dans le .env du backend NewStudies (sinon 401 / 503 sur toutes les routes internes).
INTERNAL_API_KEY=change-me-cle-interne
# Délai HTTP de l'inscription après paiement, en ms (défaut : 10000)
ENROLLMENT_TIMEOUT_MS=10000

# Active/désactive l'étape « crédit de commission » (défaut : true)
COMMISSION_CREDIT_ENABLED=true
# Délai HTTP du crédit de commission, en ms (défaut : 10000 = 10 s)
COMMISSION_CREDIT_TIMEOUT_MS=10000
# Essais internes sur réseau/5xx/429 avec backoff exponentiel (défaut : 3)
COMMISSION_CREDIT_MAX_ATTEMPTS=3
# Base du backoff exponentiel, en ms (défaut : 1000)
COMMISSION_CREDIT_RETRY_DELAY_MS=1000

# --- Tunnel d'achat (purchase-engine) ---
# URL publique du purchase-engine : pages de retour du paiement (/success, /cancel, /failed) ET origine
# toujours autorisée par CORS (sinon le tunnel est bloqué par le navigateur).
PURCHASE_ENGINE_URL=http://localhost:3005
# Origines autorisées supplémentaires (séparées par des virgules). Vide = défauts locaux + dashboards de production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3004

# --- Frontend / emails ---
FRONTEND_URL=http://localhost:3004
NEWSTUDIES_FRONTEND_URL=http://localhost:3004
ADMIN_EMAIL=admin@studiesholding.com
