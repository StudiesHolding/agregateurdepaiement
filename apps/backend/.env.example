# ============================================================
# Agrégateur de paiement — exemple de configuration (.env)
# Copier vers .env et adapter. Ne jamais committer le .env réel.
# ============================================================

# --- Base de données (MariaDB/MySQL) ---
DATABASE_NAME=agregateur
DATABASE_USER=user
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=3306

# --- Redis (BullMQ, saga) ---
REDIS_URL=redis://localhost:6379

# --- Authoring Engine (Moodle, M2M signé HMAC) ---
AUTHORING_ENGINE_URL=http://localhost:4001
SAGA_API_KEY=change-me-secret-partage
M2M_HTTP_TIMEOUT=15000

# --- Backend métier Studies Learning : crédit de commission (S1-5) ---
# Appelé par la saga après une inscription B2C réussie :
# POST {SL_BACKEND_URL}/api/internal/payments/confirmed
SL_BACKEND_URL=http://localhost:3005
INTERNAL_API_KEY=change-me-cle-interne

# Active/désactive l'étape « crédit de commission » (défaut : true)
COMMISSION_CREDIT_ENABLED=true
# Délai HTTP du crédit de commission, en ms (défaut : 10000 = 10 s)
COMMISSION_CREDIT_TIMEOUT_MS=10000
# Essais internes sur réseau/5xx/429 avec backoff exponentiel (défaut : 3)
COMMISSION_CREDIT_MAX_ATTEMPTS=3
# Base du backoff exponentiel, en ms (défaut : 1000)
COMMISSION_CREDIT_RETRY_DELAY_MS=1000

# --- Frontend / emails ---
FRONTEND_URL=http://localhost:3004
NEWSTUDIES_FRONTEND_URL=http://localhost:3004
ADMIN_EMAIL=admin@studiesholding.com
