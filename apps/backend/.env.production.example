# Production — Agrégateur de paiement
# Copier vers .env sur le serveur. NE PAS utiliser Mailpit en production.

NODE_ENV=production

# ─── SMTP réel (Ionos) — les emails arrivent dans les vraies boîtes Gmail, etc. ───
MAIL_HOST=smtp.ionos.fr
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=no-reply@studieslearning.com
MAIL_PASS=CHANGE_ME
MAIL_FROM_NAME=Studies Learning
MAIL_FROM_EMAIL=no-reply@studieslearning.com

# ─── Jamais en production ───
# MAIL_HOST=localhost
# MAIL_PORT=1025
# NODE_ENV=test

SAGA_MOCK_MOODLE_ENROLLMENT=false
AUTHORING_ENGINE_URL=https://authoring.votre-domaine.com
NEWSTUDIES_FRONTEND_URL=https://campus.votre-domaine.com
CORS_ALLOWED_ORIGINS=https://campus.votre-domaine.com,https://dashboard.studieslearning.com,https://sl-business.studieslearning.com
SAGA_API_KEY=CHANGE_ME_LONG_SECRET
